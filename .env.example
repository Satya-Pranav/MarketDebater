# ============================================================
# MarketDebater Swarm — configuration template
# Copy to `.env` and fill in your values:  cp .env.example .env
# Anything left blank falls back to a code default where one exists.
# (On a host like Streamlit Community Cloud, set these as Secrets instead.)
# ============================================================

# ----- Azure AI Foundry / Azure OpenAI (the LLM brain) -------
# Base resource endpoint. The code appends /openai/v1 itself, so use the host:
#   Azure OpenAI resource:  https://<resource>.openai.azure.com/
#   Azure AI Foundry / AI Services resource:  https://<resource>.services.ai.azure.com/
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-key>
AZURE_OPENAI_API_VERSION=2024-10-21

# Deployment NAMES you created in Azure AI Foundry (must match exactly).
# CHAT_DEPLOYMENT = Chair (fast, cheap — DeepSeek-V4-Flash recommended).
# PERSONA_DEPLOYMENT = fallback for personas when no reasoning deployment exists.
# PERSONA_R1_DEPLOYMENT = OPTIONAL DeepSeek-R1 (or other reasoning model) for personas.
#   When set, Bull/Bear/Risk route to R1; Chair stays on CHAT_DEPLOYMENT.
#   R1 requires a PAID Azure subscription (not the free trial).
AZURE_OPENAI_CHAT_DEPLOYMENT=DeepSeek-V4-Flash
AZURE_OPENAI_PERSONA_DEPLOYMENT=DeepSeek-V4-Flash
AZURE_OPENAI_PERSONA_R1_DEPLOYMENT=
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# Optional local-dev fallback: if Azure isn't ready, set this and the app
# will use standard OpenAI instead. Leave blank to force Azure.
OPENAI_API_KEY=

# ----- Grok (news layer) — served via Azure AI Foundry ------
# Foundry's catalog serves xAI Grok via the same /openai/v1 endpoint and the
# same Azure key. GROK_MODEL = the Foundry deployment name to route to.
# Leave blank to disable Grok and pass raw RSS through to the personas.
GROK_MODEL=grok-4-1-fast-reasoning

# ----- SEC filings (sec-api.io) -----------------------------
# Used by app/filings_client.py. If blank, debates run without filings input.
# Free tier = 100 calls TOTAL — get a Personal plan for daily scans.
SEC_API_KEY=
SEC_API_BASE=https://api.sec-api.io

# ----- Universe ---------------------------------------------
# Default: a curated 25-ticker watchlist in app/data/watchlist.txt — edit freely.
# To scan the larger Google Sheet (~4.6k US tickers, includes SPACs/warrants),
# set UNIVERSE_FROM_SHEET=1. Plan for ~5 min/ticker with R1 — full sheet is days.
WATCHLIST_FILE=
UNIVERSE_FROM_SHEET=0
UNIVERSE_SHEET_ID=1PEFP4UJzsEOv3h04kXlGkbhYHwOiTycCMR4WzKan2Cs
UNIVERSE_SHEET_GID=0

# ----- Verdict persistence (Azure Blob Storage) -------------
# Either set AZURE_STORAGE_CONNECTION_STRING (Blob) OR LOCAL_RESULTS_DIR
# (filesystem, for dev). With neither, scans run but verdicts are not persisted.
AZURE_STORAGE_CONNECTION_STRING=
BLOB_CONTAINER=marketdebater-verdicts
LOCAL_RESULTS_DIR=

# ----- Azure AI Search (RAG over news + filings) ------------
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=marketdebater-news

# ----- Market data fallback ---------------------------------
# Optional NewsAPI key (currently unused; reserved for future news provider swap).
NEWSAPI_KEY=
# Comma-separated default tickers for the interactive (single-ticker) UI fallback.
DEFAULT_TICKERS=AAPL,MSFT,GOOGL,NVDA,AMZN

# ----- App behaviour ----------------------------------------
# Debate rounds: 3 = case + rebuttal + closing (current default).
DEBATE_ROUNDS=3
# MOCK_MODE=1 runs the whole pipeline from deterministic stubs (no network/Azure).
MOCK_MODE=0
# Cap LLM spend per debate run (hard limit on agent turns).
MAX_AGENT_TURNS=12
# Run the debate through Microsoft Agent Framework (needs `pip install -r requirements-maf.txt`,
# Python 3.10+). Falls back to the built-in orchestrator if unset/unavailable or in MOCK_MODE.
USE_AGENT_FRAMEWORK=0
# Optional access password for the hosted Streamlit app. If set, users must enter it
# before running real (paid) debates. Leave blank to disable the gate (e.g. local dev).
APP_PASSWORD=
